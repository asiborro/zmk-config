if SHIELD_ROSEBLUE_RIGHT

config ZMK_KEYBOARD_NAME
    default "roseblue"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_ROSEBLUE_RIGHT

if SHIELD_ROSEBLUE_LEFT || SHIELD_ROSEBLUE_RIGHT

config ZMK_SPLIT
    default y

config SPI
    default y

config ZMK_RGB_UNDERGLOW
    default y
    select WS2812_STRIP
    select SPI

config ZMK_RGB_UNDERGLOW_BRT_START
    default 50

config ZMK_RGB_UNDERGLOW_EFF_START
    default 3

endif # SHIELD_ROSEBLUE_LEFT || SHIELD_ROSEBLUE_RIGHT
