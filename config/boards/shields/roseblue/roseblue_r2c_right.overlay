/* Right peripheral: forward its sensor's raw motion to the left central. */
#include "roseblue_r2c.dtsi"
#include "../common/pmw3610-hardware.dtsi"

&roseblue_trackball_split {
    device = <&trackball>;
};

&bootloader_key_right {
    status = "okay";
};

&default_transform {
    col-offset = <7>;
};
