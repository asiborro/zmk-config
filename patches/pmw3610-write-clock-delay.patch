 static int reg_write(const struct device *dev, uint8_t reg, uint8_t val) {
     int err;
 
     // enable spi clock
-    err = _reg_write(dev, PMW3610_REG_SPI_CLK_ON_REQ, PMW3610_SPI_CLOCK_CMD_ENABLE);
+    err = spi_clock_enable(dev);
     if (unlikely(err != 0)) {
         return err;
     }
