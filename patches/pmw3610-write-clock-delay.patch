+/* PMW3610 datasheet, Write Operation: wait 300 us after requesting the
+ * sensor's SPI clock before writing any target register. The normal SPI
+ * inter-command delay is only 30 us and does not satisfy this requirement.
+ */
+static int spi_clock_enable(const struct device *dev) {
+    int err = _reg_write(dev, PMW3610_REG_SPI_CLK_ON_REQ, PMW3610_SPI_CLOCK_CMD_ENABLE);
+    if (!err) {
+        k_busy_wait(300);
+    }
+    return err;
+}
