  "panels": [
    {
      "id": 19,
      "title": "roseblue \u00b7 USB trackball",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "USB diagnostics from device **047B8C32401DC31D**, saved every 10 seconds. Move the ball for fresh SQUAL and shutter samples. Idle samples older than 30 seconds are hidden; missing data is never zero. **SQUAL is not a distance measurement or a quality percentage.** The comparisons below use the same PMW3610 settings on both devices; roseblue has USB debugging enabled."
      }
    },
    {
      "id": 20,
      "title": "Trackball SQUAL now",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Raw register, 0\u2013255. A genuine zero is retained; missing or old samples are not zero.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No recent sample",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
