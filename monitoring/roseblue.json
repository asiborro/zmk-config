    {
      "id": 22,
      "title": "Age of sensor sample",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Time since the last successful sensor burst. Old samples can mean idle or stalled acquisition; an old reading is not live quality.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "Unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
