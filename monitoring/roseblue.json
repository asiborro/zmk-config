{
  "uid": "roseblue",
  "title": "roseblue",
  "description": "Separate USB diagnostics for roseblue, selected by hardware serial 047B8C32401DC31D. The sensor configuration matches darkblue; the USB debug transport differs. No battery or left-half values are inferred.",
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "tags": [
    "keyboard",
    "trackball",
    "usb"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 19,
      "title": "roseblue \u00b7 USB trackball",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Last captured values stay visible for 24 hours; age and status show freshness. **Move the ball to refresh.** Graphs use 15-second samples; gaps mean no fresh reading. SQUAL is a raw 0\u2013255 register, not a percentage or ball-height measurement."
      }
    },
    {
      "id": 20,
      "title": "Last captured SQUAL",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Most recent valid reading within the last 24 hours, retained for reference during idle or disconnect. Check sample age and status for freshness. Move the ball to generate a new sample.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No captured sample yet",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time((peamk_trackball_squal{job=\"roseblue\",half=\"right\"} >= 0)[24h:15s])",
          "legendFormat": "roseblue",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "maxDataPoints": 2000
    },
