  "version": 4,
  "editable": false,
  "tags": [
    "keyboard",
    "trackball",
    "usb"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 19,
      "title": "roseblue · USB trackball",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**PAW3395 VIK · 400 CPI · 1:1 movement** · USB `A0DD18E29D278282`. **Move the ball to refresh.** SQUAL is raw 0–255; shutter is 12-bit (0–4095) exposure in sensor clock cycles. Last captured cards retain PAW3395 readings for 24 hours; status and age show freshness. Graph gaps mean no fresh sample. PMW3610 history is excluded from PAW3395 panels."
      }
    },
    {
      "id": 20,
      "title": "Last captured SQUAL",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Most recent PAW3395 SQUAL within 24 hours. PMW3610 samples are excluded. Check sample age and status for freshness.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No captured sample yet",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time((keyboard_trackball_squal{job=\"roseblue\",half=\"right\",sensor=\"paw3395\"} >= 0)[24h:15s])",
          "legendFormat": "roseblue · PAW3395",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "maxDataPoints": 2000
    },
