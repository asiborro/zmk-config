    {
      "id": 23,
      "title": "Sensor status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "ok: recent sample; stale: idle or acquisition stopped; no_sample: no burst yet; error: sensor operation failed; unsupported: firmware/service not available.",
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Collector unavailable",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Recent sample",
                  "color": "green"
                },
                "2": {
                  "text": "No recent sample",
                  "color": "yellow"
                },
                "3": {
                  "text": "Move the ball",
                  "color": "yellow"
                },
                "4": {
                  "text": "Sensor not ready",
                  "color": "red"
                },
                "5": {
                  "text": "Sensor error",
                  "color": "red"
                },
                "6": {
                  "text": "USB debug firmware needed",
                  "color": "orange"
                },
                "7": {
                  "text": "Waiting for USB frames",
                  "color": "yellow"
                },
                "8": {
                  "text": "USB disconnected",
                  "color": "orange"
                },
                "9": {
                  "text": "No diagnostic data",
                  "color": "orange"
                },
                "10": {
                  "text": "Unsupported firmware",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max((keyboard_trackball_state_info{job=\"roseblue\",state=\"ok\"} * 1) or (keyboard_trackball_state_info{job=\"roseblue\",state=\"stale\"} * 2) or (keyboard_trackball_state_info{job=\"roseblue\",state=\"no_sample\"} * 3) or (keyboard_trackball_state_info{job=\"roseblue\",state=\"not_ready\"} * 4) or (keyboard_trackball_state_info{job=\"roseblue\",state=\"error\"} * 5) or (keyboard_trackball_state_info{job=\"roseblue\",state=\"no_console\"} * 6) or (keyboard_trackball_state_info{job=\"roseblue\",state=\"waiting\"} * 7) or (keyboard_trackball_state_info{job=\"roseblue\",state=\"disconnected\"} * 8) or (keyboard_trackball_state_info{job=\"roseblue\",state=\"unavailable\"} * 9) or (keyboard_trackball_state_info{job=\"roseblue\",state=\"unsupported\"} * 10))",
          "legendFormat": "Status",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "maxDataPoints": 2000
    },
