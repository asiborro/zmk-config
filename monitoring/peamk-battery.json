      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "peamk_battery_discharge_ratio{job=\"peamk-battery\"}",
          "legendFormat": "{{half}} \u00b7 LEDs {{leds}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
