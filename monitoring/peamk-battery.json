{
  "uid": "peamk-battery",
  "title": "PeaMK battery",
  "description": "Left and right battery estimates, supply voltage, inferred USB power, RGB and data freshness. Five-minute history continues while charging.",
  "schemaVersion": 39,
  "version": 4,
  "editable": false,
  "tags": [
    "keyboard",
    "battery"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Battery history",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Both halves logged every five minutes, including while charging.** Power is inferred from supply voltage; USB means charge level and completion are unknown.\n\nCharge percentages are uncalibrated voltage estimates. LED comparisons appear after ten minutes of stable battery use; gaps mean USB, settling or unavailable readings."
      }
    },
    {
      "id": 16,
      "title": "Left battery now",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Latest five-minute sample. Percentage is a voltage estimate. USB and settling are shown explicitly instead of an old percentage.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "noValue": "Unavailable",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 10,
                "color": "orange"
              },
              {
                "value": 21,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "101": {
                  "text": "USB",
                  "color": "orange"
                },
                "102": {
                  "text": "Settling",
                  "color": "blue"
                },
                "103": {
                  "text": "Uncertain",
                  "color": "gray"
                },
                "104": {
                  "text": "Unavailable",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * peamk_battery_estimated_ratio{job=\"peamk-battery\",half=\"left\"}) or on(half) (101 * peamk_reporting_state_info{job=\"peamk-battery\",half=\"left\",state=~\"usb\"}) or on(half) (102 * peamk_reporting_state_info{job=\"peamk-battery\",half=\"left\",state=~\"settling\"}) or on(half) (103 * peamk_reporting_state_info{job=\"peamk-battery\",half=\"left\",state=~\"uncertain\"}) or on(half) (104 * peamk_reporting_state_info{job=\"peamk-battery\",half=\"left\",state=~\"unavailable|stale|disconnected\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Left",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "maxDataPoints": 2000
    },
