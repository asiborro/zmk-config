                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "peamk_usb_power{job=\"peamk-battery\"} and on(half) peamk_condition_source_info{job=\"peamk-battery\",source=~\"voltage-inference|annotation\"}",
          "legendFormat": "{{half}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "maxDataPoints": 2000
    },
