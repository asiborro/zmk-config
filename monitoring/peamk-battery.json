    {
      "id": 2,
      "title": "Battery charge estimate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Only shown in the battery voltage range, with a fresh sample. USB, ambiguous supply voltage and settling create gaps. The default curve is not calibrated to these cells.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "Unknown",
          "color": {
            "mode": "palette-classic"
          },
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "always",
            "axisLabel": "",
            "pointSize": 3
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^left(?:$| .*)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^right(?:$| .*)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "last"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "peamk_battery_estimated_ratio{job=\"peamk-battery\"}",
          "legendFormat": "{{half}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "maxDataPoints": 2000
    },
    {
      "id": 3,
      "title": "Battery-only comparison by LED setting",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Needs ten minutes of stable battery power and known LED settings. USB, stale readings and clipped 0/100% readings are excluded. Empty until a usable comparison sample exists.",
