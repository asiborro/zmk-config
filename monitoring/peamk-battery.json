    {
      "id": 8,
      "title": "Power source (voltage estimate)",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "At least 4.4 V suggests USB; at most 4.25 V suggests battery; the gap is uncertain. A sagging USB supply can overlap battery voltage. Earlier firmware VBUS labels were unreliable and are excluded here. This cannot measure charging current or completion.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "noValue": "Unknown",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Battery",
                  "color": "green"
                },
                "1": {
                  "text": "USB",
                  "color": "orange"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
