[Unit]
Description=Send PeaMK metrics to ci4.test through a private SSH tunnel
After=peamk-battery.service
Wants=peamk-battery.service

[Service]
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ConnectTimeout=10 -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:19108:127.0.0.1:19108 ci4.test
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
