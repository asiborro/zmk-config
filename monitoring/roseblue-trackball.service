[Unit]
Description=roseblue USB trackball history

[Service]
ExecStart=/usr/bin/python3 %h/.local/lib/keyboard-telemetry/trackball_usb_monitor.py --keyboard roseblue --serial A0DD18E29D278282 --database %h/.local/share/roseblue/paw3395-A0DD18E29D278282.sqlite3
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
